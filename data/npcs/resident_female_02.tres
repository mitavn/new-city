[resource]
script = ExtResource("1_npcdata")
id = &"032"
display_name = "ID32-Em Vy"
gender = &"female"
description = "Cô gái trẻ trung với áo thun xanh lơ mát mẻ và quần jean tối màu."
sprite_frames = SubResource("SpriteFrames_resid")
spritesheet_path = "res://assets/spritesheets/characters/Character-Variation-1_04.png"
dialogues = Array[String](["Chào bạn! Không khí trong lành ven hồ thành phố làm lòng người nhẹ nhõm.", "Tôi vừa kết thúc ca trực tình nguyện tại trung tâm cộng đồng.", "Giúp đỡ mọi người luôn mang lại niềm hạnh phúc giản dị."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
