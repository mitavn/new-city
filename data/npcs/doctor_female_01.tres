[resource]
script = ExtResource("1_npcdata")
id = &"006"
display_name = "ID06-Cô Thảo"
role = &"doctor"
gender = &"female"
description = "Nữ bác sĩ / điều dưỡng, áo blouse trắng trang nhã, tóc nâu ngắn."
sprite_frames = SubResource("SpriteFrames_docto")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_14.png"
dialogues = Array[String](["Xin chào! Đừng quên rửa tay thường xuyên và ăn uống điều độ.", "Nếu cảm thấy mệt mỏi, hãy nghỉ ngơi một chút nhé.", "Phòng y tế thành phố luôn sẵn sàng các loại thuốc thiết yếu."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
