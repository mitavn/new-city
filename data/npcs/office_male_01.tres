[resource]
script = ExtResource("1_npcdata")
id = &"009"
display_name = "ID09-Anh Huy"
role = &"office"
gender = &"male"
description = "Nhân viên công sở nam, mặc vest xanh lịch sự, cà vạt chỉnh chu."
sprite_frames = SubResource("SpriteFrames_offic")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_17.png"
dialogues = Array[String](["Chào bạn! Tôi đang trên đường đến buổi họp giao ban buổi sáng.", "Khu văn phòng hôm nay có nhiều dự án công nghệ mới được triển khai.", "Một ly cà phê sáng giúp tôi tập trung làm việc hơn hẳn."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
