[resource]
script = ExtResource("1_npcdata")
id = &"011"
display_name = "ID11-Chú Hải"
role = &"sanitation"
gender = &"male"
description = "Nhân viên vệ sinh đô thị nam, đồng phục xanh lá cây môi trường sạch đẹp."
sprite_frames = SubResource("SpriteFrames_sanit")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_19.png"
move_speed = 55.0
dialogues = Array[String](["Giữ gìn thành phố xanh - sạch - đẹp là niềm tự hào của chúng tôi!", "Hãy phân loại rác thải đúng cách để bảo vệ môi trường bạn nhé.", "Mỗi góc phố sạch sẽ làm thành phố đáng sống hơn từng ngày."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
