[resource]
script = ExtResource("1_npcdata")
id = &"019"
display_name = "ID19-Anh Thành"
role = &"executive"
gender = &"male"
description = "Doanh nhân cấp cao nam, bộ âu phục tuxedo đen sang trọng, phong độ."
sprite_frames = SubResource("SpriteFrames_execu")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_27.png"
dialogues = Array[String](["Thời gian là tài sản quý báu nhất. Đầu tư đúng hướng sẽ mang lại tương lai.", "Thành phố này đang vươn mình thành trung tâm tài chính lớn.", "Tầm nhìn chiến lược và sự kiên trì là chìa khóa của mọi thành công."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
