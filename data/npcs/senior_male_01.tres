[resource]
script = ExtResource("1_npcdata")
id = &"015"
display_name = "ID15-Ông Tư"
role = &"senior"
gender = &"male"
description = "Cụ ông tóc bạc, đeo kính lão, áo len xám ấm áp và dáng đi khoan thai."
sprite_frames = SubResource("SpriteFrames_senio")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_23.png"
move_speed = 45.0
dialogues = Array[String](["Thành phố này thay đổi nhiều quá, ngày càng khang trang và hiện đại.", "Mỗi buổi sáng đi dạo dưới hàng cây thế này thật thư thái tâm hồn.", "Các cháu thanh niên hãy luôn giữ gìn sức khỏe và sống lạc quan nhé."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
