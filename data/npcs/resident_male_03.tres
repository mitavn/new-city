[resource]
script = ExtResource("1_npcdata")
id = &"033"
display_name = "ID33-Anh Đức"
gender = &"male"
description = "Chàng trai thư sinh, áo len mỏng xám lịch lãm và quần âu."
sprite_frames = SubResource("SpriteFrames_resid")
spritesheet_path = "res://assets/spritesheets/characters/Character-Variation-1_05.png"
move_speed = 55.0
dialogues = Array[String](["Chào bạn! Một tách trà nóng và một cuốn sách hay là sở thích của tôi.", "Khu bảo tàng lịch sử thành phố vừa khai mạc triển lãm mới rất đáng xem.", "Tri thức mở ra cánh cửa nhìn ra thế giới rộng lớn."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
