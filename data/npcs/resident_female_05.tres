[resource]
script = ExtResource("1_npcdata")
id = &"038"
display_name = "ID38-Em Chi"
gender = &"female"
description = "Cô gái nữ tính với áo blouse màu tím lavender ngọt ngào."
sprite_frames = SubResource("SpriteFrames_resid")
spritesheet_path = "res://assets/spritesheets/characters/Character-Variation-1_10.png"
dialogues = Array[String](["Chào bạn! Mùi hương hoa oải hương làm dịu đi những căng thẳng bộn bề.", "Thành phố này có những góc ban công trồng hoa rực rỡ rất thơ mộng.", "Chúc bạn luôn tìm thấy niềm vui trong từng việc nhỏ nhặt!"])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
