[resource]
script = ExtResource("1_npcdata")
id = &"004"
display_name = "ID04-Chị Hoa"
role = &"construction"
gender = &"female"
description = "Nữ công nhân xây dựng, áo bảo hộ phản quang, nón bảo hộ công trình."
sprite_frames = SubResource("SpriteFrames_const")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_12.png"
move_speed = 55.0
dialogues = Array[String](["Chào bạn, cẩn thận vật liệu xây dựng rơi vãi nhé.", "Bản vẽ kiến trúc đợt này được thiết kế rất thông minh và hiện đại.", "Công việc tuy vất vả nhưng nhìn thành phố phát triển là vui rồi!"])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
