[resource]
script = ExtResource("1_npcdata")
id = &"014"
display_name = "ID14-Em Trang"
role = &"delivery"
gender = &"female"
description = "Nữ shipper giao nhận bưu phẩm, mũ lưỡi trai và đồng phục chuyển phát."
sprite_frames = SubResource("SpriteFrames_deliv")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_22.png"
move_speed = 70.0
dialogues = Array[String](["Kiện bưu phẩm của bạn đang trên đường vận chuyển an toàn!", "Giao hàng nhanh chóng và tận tâm là phương châm của tôi.", "Hôm nay số lượng đơn hàng tăng cao, thành phố thật tấp nập."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
