[resource]
script = ExtResource("1_npcdata")
id = &"018"
display_name = "ID18-Chị Yến"
role = &"firefighter"
gender = &"female"
description = "Nữ chiến sĩ cứu hỏa kiên cường, trang phục phòng cháy chữa cháy đỏ rực."
sprite_frames = SubResource("SpriteFrames_firef")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_26.png"
move_speed = 65.0
dialogues = Array[String](["Chúng tôi vừa hoàn thành buổi diễn tập cứu hộ định kỳ tại tòa nhà.", "Hãy ghi nhớ số điện thoại khẩn cấp để gọi ngay khi gặp nguy hiểm.", "Bình tĩnh là yếu tố quan trọng nhất khi xử lý sự cố."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
