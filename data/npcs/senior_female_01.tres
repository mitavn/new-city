[resource]
script = ExtResource("1_npcdata")
id = &"016"
display_name = "ID16-Bà Sáu"
role = &"senior"
gender = &"female"
description = "Cụ bà tóc muối tiêu bới cao, đeo kính tròn, phong thái hiền từ."
sprite_frames = SubResource("SpriteFrames_senio")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_24.png"
move_speed = 45.0
dialogues = Array[String](["Chào cháu! Cháu có muốn thử chút bánh quy bà mới nướng không?", "Không khí buổi sớm mai ở công viên trong lành và dễ chịu biết bao.", "Thời gian trôi nhanh thật, chúc các cháu luôn gặp nhiều điều may mắn."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
