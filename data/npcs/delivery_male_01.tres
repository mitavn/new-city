[resource]
script = ExtResource("1_npcdata")
id = &"013"
display_name = "ID13-Anh Nam"
role = &"delivery"
gender = &"male"
description = "Shipper giao hàng nam, đội mũ lưỡi trai, áo khoác vàng cam chuyển phát nhanh."
sprite_frames = SubResource("SpriteFrames_deliv")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_21.png"
move_speed = 70.0
dialogues = Array[String](["Đơn hàng tiếp theo đang chờ tôi giao đến tận tay khách hàng đây!", "Mọi ngõ ngách trong thành phố này tôi đều nhớ như in trong lòng bàn tay.", "Chúc bạn có một ngày nhận hàng đúng hẹn và vui vẻ!"])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
