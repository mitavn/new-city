[resource]
script = ExtResource("1_builddata")
id = &"bld_002"
display_name = "Đồn Cảnh Sát Thành Phố"
building_type = &"emergency"
description = "Trụ sở cảnh sát đô thị với cửa kính văn phòng bên trái và cửa cuốn gara xe tuần tra bên phải."
frame_size = Vector2i(224, 160)
door_count = 2
door_names = Array[String](["Cửa Văn Phòng", "Cửa Cuốn Gara Xe"])
sprite_frames = SubResource("SpriteFrames_police")
spritesheet_path = "res://assets/spritesheets/buildings/Building Door Animations/PoliceStation Animation.png"
collision_size = Vector2(200, 50)
door_positions = Array[Vector2]([Vector2(-70, -8), Vector2(50, -8)])
tags = PackedStringArray("emergency", "building", "default", "two_door")
