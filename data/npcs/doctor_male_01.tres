[resource]
script = ExtResource("1_npcdata")
id = &"005"
display_name = "ID05-Bác Minh"
role = &"doctor"
gender = &"male"
description = "Bác sĩ nam áo blouse trắng, đeo ống nghe y tế, phong thái ân cần."
sprite_frames = SubResource("SpriteFrames_docto")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_13.png"
dialogues = Array[String](["Sức khỏe là vốn quý nhất, nhớ tập thể dục và uống đủ nước nhé.", "Bệnh viện thành phố luôn mở cửa tiếp nhận bệnh nhân 24/7.", "Hôm nay bạn cảm thấy trong người có khỏe khoắn không?"])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
