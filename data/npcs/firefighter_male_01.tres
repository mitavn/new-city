[resource]
script = ExtResource("1_npcdata")
id = &"017"
display_name = "ID17-Anh Hùng"
role = &"firefighter"
gender = &"male"
description = "Chiến sĩ cứu hỏa nam, đồ bảo hộ chống cháy màu đỏ cam dũng cảm."
sprite_frames = SubResource("SpriteFrames_firef")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_25.png"
move_speed = 65.0
dialogues = Array[String](["Đội cứu hỏa luôn túc trực 24/7 sẵn sàng ứng phó mọi tình huống khẩn cấp!", "Hãy kiểm tra ổ điện và bếp gas cẩn thận trước khi ra khỏi nhà.", "An toàn phòng cháy chữa cháy là trách nhiệm của mỗi chúng ta."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
