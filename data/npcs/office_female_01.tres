[resource]
script = ExtResource("1_npcdata")
id = &"010"
display_name = "ID10-Chị Linh"
role = &"office"
gender = &"female"
description = "Nữ nhân viên văn phòng năng động, áo sơ mi trang nhã và chân váy công sở."
sprite_frames = SubResource("SpriteFrames_offic")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_18.png"
dialogues = Array[String](["Chào bạn! Deadline tuần này khá gấp nhưng mọi người đều nỗ lực.", "Thành phố này có rất nhiều cơ hội việc làm hấp dẫn.", "Hết giờ làm tôi sẽ đi dạo thư giãn một vòng quanh công viên."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
