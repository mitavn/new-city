[resource]
script = ExtResource("1_builddata")
id = &"bld_001"
display_name = "Trạm Cứu Hỏa Thành Phố"
building_type = &"emergency"
description = "Trạm cứu hỏa trung tâm trang bị 2 cửa: cửa đi bộ nhân viên bên trái và cửa cuốn gara xe bên phải."
