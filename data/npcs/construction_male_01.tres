[resource]
script = ExtResource("1_npcdata")
id = &"003"
display_name = "ID03-Anh Tuấn"
role = &"construction"
gender = &"male"
description = "Công nhân xây dựng nam, áo gile cam dạ quang, đội mũ bảo hộ vàng."
sprite_frames = SubResource("SpriteFrames_const")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_11.png"
move_speed = 55.0
dialogues = Array[String](["Chú ý an toàn lao động! Hãy đội mũ bảo hộ khi vào gần công trình.", "Chúng tôi đang xây thêm nhiều công trình mới cho thành phố.", "Cần một nền móng vững chắc thì nhà mới bền đẹp được!"])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
