[resource]
script = ExtResource("1_npcdata")
id = &"001"
display_name = "ID01-Anh Tâm"
role = &"police"
gender = &"male"
description = "Sĩ quan cảnh sát nam, sắc phục xanh lam, đội mũ kepi tuần tra."
sprite_frames = SubResource("SpriteFrames_polic")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_09.png"
move_speed = 200.0
wander_radius = 200.0
dialogues = Array[String](["Xin chào! Khu vực này đang được đảm bảo an ninh trật tự.", "Hãy luôn tuân thủ luật giao thông khi di chuyển trong thành phố nhé!", "Nếu phát hiện điều gì bất thường, hãy báo ngay cho chúng tôi."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
