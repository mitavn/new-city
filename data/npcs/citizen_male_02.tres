[resource]
script = ExtResource("1_npcdata")
id = &"023"
display_name = "ID23-Anh Bình"
gender = &"male"
description = "Nam thanh niên dạo phố, áo thun xám hiện đại và quần xanh ngọc."
sprite_frames = SubResource("SpriteFrames_citiz")
spritesheet_path = "res://assets/spritesheets/characters/City-Characters_03.png"
dialogues = Array[String](["Chào người anh em! Có biết phòng tập thể thao gần nhất ở đâu không?", "Thành phố này nhộn nhịp về đêm lắm, bạn đã thử đi dạo đêm chưa?", "Âm nhạc đường phố ở quảng trường hôm nay nghe rất cuốn hút."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
