[resource]
script = ExtResource("1_npcdata")
id = &"037"
display_name = "ID37-Anh Vũ"
gender = &"male"
description = "Chàng trai lịch lãm với áo sơ mi màu nâu camel và quần xanh sẫm."
sprite_frames = SubResource("SpriteFrames_resid")
spritesheet_path = "res://assets/spritesheets/characters/Character-Variation-1_09.png"
dialogues = Array[String](["Chào bạn! Hôm nay tôi có hẹn gặp đối tác ở quán cà phê trung tâm.", "Thành phố phát triển mở ra rất nhiều cơ hội hợp tác mới.", "Hy vọng công việc của bạn cũng luôn suôn sẻ và gặt hái thành công."])
metadata/_custom_type_script = "uid://1jm7l62oqmyb"
